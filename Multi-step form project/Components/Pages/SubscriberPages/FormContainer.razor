@page "/"
@using Microsoft.EntityFrameworkCore
@using Multi_step_form_project.Modules
@using System.ComponentModel.DataAnnotations;
@using PhoneNumbers;
@using PhoneNumbers.Extensions;
@inject IDbContextFactory<Multi_step_form_projectContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Personal Information</PageTitle>
@if(Step == 1)
{
	<PersonalInfo requiredMessage=@aRequiredMessage/>
}
else if (Step == 2)
{
	<SelectYourPlan requiredMessage="@aRequiredMessage2"/>
} else if (Step == 3)
{
	<PickAddOns/>
} else if (Step == 4)
{
	checkMonthlyorYearly();
	viewChosenAddOns();
	
	<div class="mobile-header">
</div>
<div class="page-numbers">
	<div class="page-number">1</div>
	<div class="page-number">2</div>
	<div class="page-number">3</div>
	<div class="page-number" style="@pageNumberColor">4</div>
</div>
<div class="white-container">
	<h2 class="Section-title">Finishing up</h2>
		<p class="additional-info">Double-check everything looks OK before confirming.</p>
		<div class="choices-summary">
			<div class="first-part">
				<div class="plan-selected-final">
					<p class="plan-title">@Subscriber.PlanSelected (<span>@Subscriber.MonthlyOrYearly</span>)</p>
					<p class="change-plan-link" @onclick="HandleChangePlan">Change</p>
				</div>
				<div class="plan-title"><span>$</span>@Subscriber.TotalCost /<span>@perMoOrYr</span></div>
			</div>
			<div class="second-part">
				<div class="addon-online" style="@OnlineStyles">	
					<p class="addon-description-gray">Online service</p>
					<p class="plan-title-not-bold"><span>+$</span>@OnlineServiceAmount /<span>@perMoOrYr</span></p>
				</div>
				<div class="addon-larger" style="@LargerStyles">	
					<p class="addon-description-gray">Larger storage</p>
					<p class="plan-title-not-bold"><span>+$</span>@LargerStorageAmount /<span>@perMoOrYr</span></p>
				</div>
				<div class="addon-customizable" style="@CustomizableStyles">	
					<p class="addon-description-gray">Customizable profile</p>
					<p class="plan-title-not-bold"><span>+$</span>@CustomizableProfileAmount /<span>@perMoOrYr</span></p>
				</div>
			</div>
		</div>
		<div class="final-totally-cost">
			<p class="addon-description-gray">@perMonthOrYear</p>
			<p class="the-total-addedup"> 
				<span>$</span>@theTotalfinalAmount /<span>@perMoOrYr</span>
			</p>
		</div>
	@* <p>@Subscriber.Name</p>
	<p>@Subscriber.Email</p>
	<p>@Subscriber.PhoneNumber</p>
	<p>@Subscriber.PlanSelected</p>
	<p>@Subscriber.MonthlyOrYearly</p>
	<P>@Subscriber.TotalCost</P>
	<p>@Subscriber.AddOnsCost</p> *@
</div>
}

<div class="next-and-prev">
	<div class="next-and-prev-button-container">
		@if (Step == 1)
		{

		}
		else
		{
			<button class="go-back-button" @onclick="Prev">Go Back</button>
		}
		@if (Step == 4)
		{
			
		}
		else
		{
			<button class="next-step-button" @onclick="Next">Next Step</button>
		}
	</div>
</div>

@code {
	[CascadingParameter]
	private Subscriber? Subscriber { get; set; } 

	public int Step { get; set; } = 1;
	public string pageNumberColor = "background-color:hsl(206, 94%, 87%);color:hsl(213, 96%, 18%)";
	public string aRequiredMessage = "";
	public string aRequiredMessage2 = "";
	public string perMoOrYr;
	public string perMonthOrYear;
	public int OnlineServiceAmount;
	public int LargerStorageAmount;
	public int CustomizableProfileAmount;
	public string OnlineStyles;
	public string LargerStyles;
	public string CustomizableStyles;
	public int theTotalfinalAmount;
	public EmailAddressAttribute email = new EmailAddressAttribute();
	//static PhoneNumberUtil phoneNumberUtil = PhoneNumberUtil.GetInstance();
	// public bool abool = PhoneNumbers.Extensions.PhoneNumber.TryParse("jsss", "US", out PhoneNumbers.PhoneNumber var);
	protected override void OnInitialized()
	{

	}

	public void Next()
	{
		// Step 1 checks

		if (Step == 1 && (Subscriber.Name == null||checkNameString(Subscriber.Name) == false))
		{

			aRequiredMessage = "Invalid name or not filled in";

		}
		else if (Step == 1 && (Subscriber.Email==null||(email.IsValid(Subscriber.Email) == false)))
		{
			aRequiredMessage = "email format incorrect";
		}
		else if (Step == 1 && (Subscriber.PhoneNumber==null || PhoneNumbers.Extensions.PhoneNumber.TryParseValid(Subscriber.PhoneNumber, out PhoneNumbers.PhoneNumber var)==false))
		{
			aRequiredMessage = "Must be a valid phone number";

		}
		// Step 2 checks
		else if (Step == 2 && (Subscriber.PlanSelected == null))
		{
			aRequiredMessage2 = "Select a plan!";
		} else if (Step == 4)
		{

		} else
		{

			aRequiredMessage = "";
			aRequiredMessage2 = "";
			var phoneNumberUtil = PhoneNumberUtil.GetInstance();
			PhoneNumbers.Extensions.PhoneNumber.TryParseValid(Subscriber.PhoneNumber, out PhoneNumbers.PhoneNumber yo);
			Subscriber.PhoneNumber = phoneNumberUtil.Format(yo, PhoneNumberFormat.INTERNATIONAL);

			Step++;
			StateHasChanged();

		}
	}

	public void Prev()
	{
		if (Step == 1)
		{

		}
		else
		{
			Step--;
			StateHasChanged();
		}


	}
	private bool checkNameString(string wordOrPhrase)
	{
		bool itIsFine = false;
		foreach (char character in wordOrPhrase)
		{
			if (((int)character >= 65 && (int)character <= 90) || ((int)character >= 97 && (int)character <= 122))
			{
				itIsFine = true;
			}
			else
			{

			}



		}
		return itIsFine;
	}

	private void HandleChangePlan()
	{
		Step = 2;
		StateHasChanged();
	}

	private void checkMonthlyorYearly()
	{
		if (Subscriber.MonthlyOrYearly == "Monthly")
		{
			OnlineServiceAmount = 1;
			LargerStorageAmount = 2;
			CustomizableProfileAmount = 2;
			perMoOrYr = "mo";
			perMonthOrYear = "Total (per month)";
		}
		else if (Subscriber.MonthlyOrYearly == "Yearly")
		{
			OnlineServiceAmount = 1*10;
			LargerStorageAmount = 2*10;
			CustomizableProfileAmount = 2*10;
			perMoOrYr = "yr";
			perMonthOrYear = "Total (per year)";
		} else
		{

		}
	}
	private void viewChosenAddOns()
	{
		OnlineStyles = "";
		LargerStyles = "";
		CustomizableStyles = "";
		theTotalfinalAmount = Subscriber.TotalCost + Subscriber.AddOnsCost;

		if (Subscriber.OnlineService == 1)
		{
			OnlineStyles = "display:flex;flex-direction:row;justify-content:space-between;margin-top:5px";
		}
		if (Subscriber.LargerStorage == 1)
		{
			LargerStyles = "display:flex;flex-direction:row;justify-content:space-between;margin-top:5px";
		}
		if (Subscriber.CustomizableProfile == 1)
		{
			CustomizableStyles = "display:flex;flex-direction:row;justify-content:space-between;margin-top:5px";
		}

	}
}
