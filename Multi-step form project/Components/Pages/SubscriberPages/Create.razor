@page "/subscribers/create"
@using Microsoft.EntityFrameworkCore
@using Multi_step_form_project.Modules
@inject IDbContextFactory<Multi_step_form_projectContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Subscriber</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Subscriber" OnValidSubmit="AddSubscriber" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label> 
                <InputText id="name" @bind-Value="Subscriber.Name" class="form-control" /> 
                <ValidationMessage For="() => Subscriber.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label> 
                <InputText id="email" @bind-Value="Subscriber.Email" class="form-control" /> 
                <ValidationMessage For="() => Subscriber.Email" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="phonenumber" class="form-label">PhoneNumber:</label> 
                <InputText id="phonenumber" @bind-Value="Subscriber.PhoneNumber" class="form-control" /> 
                <ValidationMessage For="() => Subscriber.PhoneNumber" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/subscribers">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Subscriber Subscriber { get; set; } = default!;

    protected override void OnInitialized() => Subscriber ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSubscriber()
    {
        using var context = DbFactory.CreateDbContext();
        context.Subscriber.Add(Subscriber);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/subscribers");
    }
}
