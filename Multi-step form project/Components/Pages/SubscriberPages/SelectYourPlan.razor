@using Multi_step_form_project.Modules
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Select Your Plan</PageTitle>
<div class="mobile-header">
</div>
<PageNumber thePageNumber="2" TopOrSide="Top"/>
<div class="white-container">
	<div class="side-image"></div>
	<div class="white-container-content">
	<h2 class="Section-title">Select Your Plan</h2>
	<p class="required-fields">@requiredMessage</p>
	<p class="additional-info"> You have the option of monthly or yearly billing.</p>
	<div class="plan-option" id="arcade-choice" @onclick="HandleArcade" style="@ArcadeStyles">
		<img src="/images/icon-arcade.svg"/>
		<div class="plan-description">
			<p class="plan-title">
				Arcade
			</p>
			<p class="plan-amount">
				$<span>@arcadePrice</span>/<span>@perMoOrYr</span>
				<span class="yearly-version">2 months free</span>
			</p>
		</div>
		</div>
		<div class="plan-option" id="advanced-choice" @onclick="HandleAdvanced" style="@AdvancedStyles">
			<img src="/images/icon-advanced.svg" />
			<div class="plan-description">
				<p class="plan-title">
					Advanced
				</p>
				<p class="plan-amount">
					$<span>@advancedPrice</span>/<span>@perMoOrYr</span>
					<span class="yearly-version">2 months free</span>
				</p>
			</div>
		</div>
		<div class="plan-option" id="pro-choice" @onclick="HandlePro" style="@ProStyles">
			<img src="/images/icon-pro.svg" />
			<div class="plan-description">
				<p class="plan-title">
					Pro
				</p>
				<p class="plan-amount">
					$<span>@proPrice</span>/<span>@perMoOrYr</span>
					<span class="yearly-version">2 months free</span>
				</p>
			</div>
		</div>
		<div class="monthly-or-yearly-container">
			<p class="Monthly-title">Monthly</p>

			<label class="switch">
				<InputCheckbox @bind-Value="MonthlyOrYearly" @bind-Value:after="HandleMonthlyAndYearly" />
				<span class="slider round"></span>
			</label>
			<p class="Yearly-title">Yearly</p>
		</div>
	</div>

	

	@*Testing code*@

	@* <p>@Subscriber.MonthlyOrYearly</p>
	<p>@MonthlyOrYearly</p>
	<p>@Subscriber.MonthlyCost</p> *@
</div>

@code {
	[CascadingParameter]
	private Subscriber? Subscriber { get; set; }
	public string pageNumberColor = "background-color:hsl(206, 94%, 87%);color:hsl(213, 96%, 18%)";
	public string OptionSelected = "";
	public string ArcadeStyles = "";
	public string AdvancedStyles = "";
	public string ProStyles = "";
	public bool MonthlyOrYearly;
	public int arcadePrice = 9;
	public int advancedPrice = 12;
	public int proPrice = 15;
	public string perMoOrYr = "mo";

	[Parameter]
	public string requiredMessage { get; set; }

	protected override void OnInitialized()
	{
		HandleOptionSelected();
		HandleYearOrMonthlySelected();
		HandleMonthlyAndYearly();
	}

	public void HandleArcade()
	{
		OptionSelected = "Arcade";
		Subscriber.PlanSelected = OptionSelected;
		HandleOptionSelected();
	}
	public void HandleAdvanced()
	{
		OptionSelected = "Advanced";
		Subscriber.PlanSelected = OptionSelected;
		HandleOptionSelected();
	}
	public void HandlePro()
	{
		OptionSelected = "Pro";
		Subscriber.PlanSelected = OptionSelected;
		HandleOptionSelected();
	}

	public void HandleOptionSelected()
	{
		if (Subscriber.PlanSelected == "Arcade")
		{
			ArcadeStyles = "background-color:hsl(225, 33%, 95%);border:1px solid hsl(213, 96%, 18%)";
			AdvancedStyles = "";
			ProStyles = "";
			setMonthlyAmount(arcadePrice);
		}
		if (Subscriber.PlanSelected == "Advanced")
		{
			ArcadeStyles = "";
			AdvancedStyles = "background-color:hsl(225, 33%, 95%);border:1px solid hsl(213, 96%, 18%)";
			ProStyles = "";
			setMonthlyAmount(advancedPrice);
		}
		if (Subscriber.PlanSelected == "Pro")
		{

			ArcadeStyles = "";
			AdvancedStyles = "";
			ProStyles = "background-color:hsl(225, 33%, 95%);border:1px solid hsl(213, 96%, 18%)";
			setMonthlyAmount(proPrice);
		}
	}

	public void HandleMonthlyAndYearly()
	{
		if (MonthlyOrYearly == false)
		{
			Subscriber.MonthlyOrYearly = "Monthly";
			arcadePrice = 9;
			advancedPrice = 12;
			proPrice = 15;
			perMoOrYr = "mo";
		} else if (MonthlyOrYearly == true)
		{
			Subscriber.MonthlyOrYearly = "Yearly";
			arcadePrice = arcadePrice * 10;
			advancedPrice = advancedPrice * 10;
			proPrice = proPrice * 10;
			perMoOrYr = "yr";
		}
		HandleOptionSelected();
	}
	
	public void HandleYearOrMonthlySelected()
	{
		if (Subscriber.MonthlyOrYearly == "Monthly")
		{
			MonthlyOrYearly = false; 

		}
		else if (Subscriber.MonthlyOrYearly == "Yearly")
		{
			MonthlyOrYearly = true;

		}
	}

	public void setMonthlyAmount(int monthlyAmount)
	{
		Subscriber.TotalCost = monthlyAmount;
	}


}
