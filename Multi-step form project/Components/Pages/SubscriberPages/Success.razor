@page "/success"
@using Microsoft.EntityFrameworkCore
@using Multi_step_form_project.Modules
@inject IDbContextFactory<Multi_step_form_projectContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Personal Information</PageTitle>
<div class="mobile-header">
</div>
<PageNumber thePageNumber="4" TopOrSide="Top"/>
<div class="white-container">
	<div class="side-image">
		<PageNumber thePageNumber="4" TopOrSide="Side" />
	</div>
	<div class="white-container-content">
	<img src="/images/icon-thank-you.svg" class="success-check"/>
	<h2 class="Section-title success-title">Thank you!</h2>
	<p class="additional-info success-paragraph">Thanks for confirming your subscription! You will be redirected in a moment....</p>
	
</div>
</div>

@code {
	[CascadingParameter]
	private Subscriber? Subscriber { get; set; }
	public string pageNumberColor = "background-color:hsl(206, 94%, 87%);color:hsl(213, 96%, 18%)";
	protected override void OnInitialized()
	{

		NavigateHome();
	}
	private async Task NavigateHome()
	{
		await Task.Delay(5000);
		NavigationManager.NavigateTo("/");
	}
}
