
@using Multi_step_form_project.Modules
@using PhoneNumbers;
@inject NavigationManager NavigationManager
@rendermode InteractiveServer


<PageTitle>Personal Information</PageTitle>
<div class="mobile-header">
	
</div>
<PageNumber thePageNumber="1" TopOrSide="Top"/>
<div class="white-container">
	<div class="side-image">
		<PageNumber thePageNumber="1" TopOrSide="Side" />
	</div>
	<div class="white-container-content">
	<h2 class="Section-title">Personal info</h2>
	<p class="required-fields">@requiredMessage</p>
	<p class="additional-info">  Please provide your name, email address, and phone number.</p>
	<div class="name-container">
		<label for="name">Name:</label>
		<InputText id="name" @bind-Value="Subscriber.Name"  class="input-text-box" placeholder="e.g. Stephen King" required/>
	</div>
	<div class="email-container">
		<label for="email">Email:</label>
		<InputText id="email" @bind-Value="Subscriber.Email"class="input-text-box" placeholder="e.g. stephenking@lorem.com" />
	</div>
	<div class="phone-number-container">
		<label for="phonenumber">PhoneNumber:</label>
		<InputText id="phonenumber" @bind-Value="Subscriber.PhoneNumber"  class="input-text-box" placeholder=" e.g. +1 234 567 890" />
	</div>
	@* Testing code *@
	@* <p>@PhoneNumberUtil.GetInstance().IsValidNumber(PhoneNumberUtil.GetInstance().Parse("+26772981057", "US"))</p> *@
	</div>
</div>

@code {
	[CascadingParameter]
	private Subscriber? Subscriber { get; set; }

	[Parameter]
	public string requiredMessage { get; set; }
	public string pageNumberColor = "background-color:hsl(206, 94%, 87%);color:hsl(213, 96%, 18%)";

}
