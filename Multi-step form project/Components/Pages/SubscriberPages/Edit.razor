@page "/subscribers/edit"
@using Microsoft.EntityFrameworkCore
@using Multi_step_form_project.Modules
@inject IDbContextFactory<Multi_step_form_projectContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Subscriber</h2>
<hr />
@if (Subscriber is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Subscriber" OnValidSubmit="UpdateSubscriber" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Subscriber.Id" value="@Subscriber.Id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Subscriber.Name" class="form-control" />
                    <ValidationMessage For="() => Subscriber.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="Subscriber.Email" class="form-control" />
                    <ValidationMessage For="() => Subscriber.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phonenumber" class="form-label">PhoneNumber:</label>
                    <InputText id="phonenumber" @bind-Value="Subscriber.PhoneNumber" class="form-control" />
                    <ValidationMessage For="() => Subscriber.PhoneNumber" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/subscribers">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Subscriber? Subscriber { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Subscriber ??= await context.Subscriber.FirstOrDefaultAsync(m => m.Id == Id);

        if (Subscriber is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSubscriber()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Subscriber!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SubscriberExists(Subscriber!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/subscribers");
    }

    private bool SubscriberExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Subscriber.Any(e => e.Id == id);
    }
}
