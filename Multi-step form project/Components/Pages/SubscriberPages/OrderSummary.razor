@using Multi_step_form_project.Modules
@using PhoneNumbers;
@inject NavigationManager NavigationManager
@rendermode InteractiveServer


<PageTitle>Order Summary</PageTitle>
<div class="mobile-header">
</div>
<div class="page-numbers">
	<div class="page-number">1</div>
	<div class="page-number">2</div>
	<div class="page-number">3</div>
	<div class="page-number" style="@pageNumberColor">4</div>
</div>
<div class="white-container">
	<h2 class="Section-title">Finishing up</h2>
	<p>@Subscriber.Name</p>
	<p>@Subscriber.Email</p>
	<p>@Subscriber.PhoneNumber</p>
	<p>@Subscriber.PlanSelected</p>
	<p>@Subscriber.MonthlyOrYearly</p>
	<P>@Subscriber.TotalCost</P>
	<p>@Subscriber.AddOnsCost</p>
</div>

@code {
	[CascadingParameter]
	private Subscriber? Subscriber { get; set; }
	public string pageNumberColor = "background-color:hsl(206, 94%, 87%);color:hsl(213, 96%, 18%)";

}
